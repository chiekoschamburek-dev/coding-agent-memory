# codemem configuration example.
#   cp .env.example .env    then edit, and pass with `docker compose --env-file .env`
# All values are optional; the defaults run a fully working CPU-only service
# with no external dependencies.

# ---------------------------------------------------------------- storage ----
# The SQLite database location. Always mount this as a volume in production;
# without it the memory corpus is lost on restart.
CODEMEM_DATA_DIR=/data
CODEMEM_DB_FILENAME=codemem.sqlite3

# ---------------------------------------------------------------- service ----
CODEMEM_HOST=0.0.0.0
CODEMEM_PORT=8080
CODEMEM_LOG_LEVEL=INFO
# Contract limits: response top_k ceiling, and the internal Add guard, which is
# set below the platform's 30-minute ceiling on purpose.
CODEMEM_MAX_TOP_K=1000
CODEMEM_ADD_DEADLINE_SECONDS=1500.0

# Shared secret for Add/Search. Accepts `Authorization: Bearer <key>`,
# `Authorization: Token <key>`, or `X-Api-Key: <key>`.
#
# Leaving this UNSET disables authentication, which the rules permit only for
# public smoke. Set it for any real evaluation run.
CODEMEM_API_KEY=

# Never log request bodies: evaluation data must not be retained beyond serving
# the task. Logs carry identifiers, sizes, and timings only.
CODEMEM_LOG_REQUEST_BODIES=false

# ------------------------------------------------------------------- llm -----
# Enrichment is OFF by default and the service is fully functional without it:
# chunking, identifier extraction, BM25, IDF entity matching and fusion are all
# deterministic and model-free.
#
# NOTE: the enrichment/query-understanding client is a P3 deliverable. Today
# these settings are consumed only by scripts/probe_provider.py, so enabling
# them changes no retrieval behaviour yet.
CODEMEM_LLM_ENABLED=false
# Session selection: one gpt-4o-mini call per Search picks the two sessions
# that record the cause/fix from compact summaries. Seven-arm champion on
# the file-overlap instrument (+0.052), REVERSED below the no-memory floor
# on the leak-free claim-topical instrument (-0.071) — the judgement
# inherits the answer model's prior, which the adversarial instrument
# points at distractors. Ships OFF; set 1 to re-enable (degrades to the
# plain ordering whenever the relay is absent, slow, or unparseable).
CODEMEM_SESSION_SELECT_LLM=0
CODEMEM_SESSION_SELECT_TIMEOUT_SECONDS=10
# Selection self-consistency: run the selection call N times and
# majority-vote the session picks. 1 = the shipped one-shot behaviour.
# The digest replay measured 8/11 recorded judgment misses flipping on a
# single re-call at temperature 0 — those queries sit on the decision
# boundary; votes>1 samples the relay's cross-request variance.
CODEMEM_SESSION_SELECT_VOTES=1

# OpenAI-compatible endpoint. For a third-party relay, point this at the relay
# and confirm the model with scripts/probe_provider.py BEFORE a Full run.
CODEMEM_LLM_BASE_URL=

# Prefer injecting this at runtime rather than committing it anywhere.
CODEMEM_LLM_API_KEY=

# Fixed by the rules for open-source entries; the platform reproduces with the
# real model, so a relay that silently routes elsewhere risks voiding results.
CODEMEM_LLM_MODEL=gpt-4o-mini
# Fraction of chunks eligible for enrichment.
CODEMEM_ENRICH_RATIO=0.25

# --------------------------------------------------------- retrieval tuning ---
# Cap on items returned from one session. A session yields many chunks; without
# a cap they crowd out other sessions and recall@k drops. Raised from 3 to 5
# after the evidence-sufficiency audit: the decisive chunk often sits deep
# inside a read-heavy trajectory and a cap of 3 truncated before reaching it.
CODEMEM_MAX_EVIDENCE_PER_SESSION=5

# Cap on distinct sessions in one payload (0 = unlimited). The companion move to
# the increase above: fewer sessions competing for the token prefix keeps
# distractor operative chunks out of the window while the answer session gets
# more slots for its decisive evidence.
CODEMEM_EVIDENCE_MAX_SESSIONS=2

# Promote a session's operative chunk into its first slot, for the top this-many
# sessions (-1 = every session, 0 = never). Every session measured 0.567
# ambiguity; with the session cap above, 2 recovers decisive evidence without
# that floodgate.
CODEMEM_EVIDENCE_OPERATIVE_PROMOTION=2

# Weight of "operative" lines (what a session DID) over query-term matches when
# selecting a verbatim window. Trajectory actions are JSON or patch syntax and
# overlap the issue wording poorly, so term density alone skips them.
CODEMEM_EVIDENCE_OPERATIVE_WEIGHT=1.0

# The same signal as a fifth *ranking* term rather than a window-selection
# weight. Off by default: the change it targets is at the level of which chunk
# carries a session's score (measured: that chunk names a file the task touched
# only 12.9% of the time). Non-zero values rescale the other four terms, so the
# noise gate below keeps its meaning.
CODEMEM_OPERATIVE_RANK_WEIGHT=0.0

# Intra-session position prior: when choosing which chunks of an already-chosen
# session take the slots, tilt scores toward the end of that trajectory. On at
# 1.0: trajectories read a file before changing it, so the late chunks carry the
# edit (the chunk naming a patched file sits at relative position 0.575, and the
# edits among them at 0.661, against 0.500 overall). Measured: that chunk is
# returned for 33.3% of the relevant sessions that have it in the pool, 42.2% at
# 1.0 (+12 gained / 0 lost, p=0.0005), 44.4% at 1.5 where it plateaus; payload
# size is unchanged and run_evidence's `decidable` rises 0.500 -> 0.567 while
# `ambiguous` falls. The proxy retrieval benchmark reports zero change: it labels
# relevance per session, and this only swaps which chunk of a session is shown.
# It never changes which sessions are returned -- as a ranking term it measured
# worse, because the tail of a distractor session looks just as late.
CODEMEM_EVIDENCE_POSITION_WEIGHT=1.0

# Noise gate. Below this normalized score, candidates are dropped rather than
# padded into the answer model's token prefix. Raise to be stricter, set to 0
# to disable.
CODEMEM_MIN_EVIDENCE_SCORE=0.15

# Always return at least this many items if any candidate clears the gate.
CODEMEM_MIN_EVIDENCE_COUNT=1

# Per-item token caps: full-form items and pointer-form items.
CODEMEM_EVIDENCE_ITEM_TOKENS=800
CODEMEM_EVIDENCE_PTR_TOKENS=110

# Total token budget for the whole `data` payload. The platform's input window
# is 117,760 tokens; stay comfortably under it.
CODEMEM_EVIDENCE_BUDGET_TOKENS=60000

CODEMEM_EVIDENCE_FULL_COUNT=8

# ------------------------------------------------------- recall and fusion ---
CODEMEM_RRF_K=60
CODEMEM_RECALL_PER_CHANNEL=120
CODEMEM_CANDIDATE_POOL=300

# --------------------------------------------------------------- chunking ----
CODEMEM_TARGET_CHUNK_TOKENS=320
CODEMEM_MAX_CHUNK_TOKENS=1400
CODEMEM_HARD_CHUNK_CHARS=24000

# ---------------------------------------------------------------- rerank -----
# ON by default: the largest measured gain, and it costs Add nothing because it
# runs only at search time. If the model is absent the stage is skipped and the
# fused recall ranking is used unchanged. Check /health for what actually loaded.
CODEMEM_RERANK_ENABLED=true
CODEMEM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CODEMEM_RERANK_DEVICE=auto
# Candidates sent through the cross-encoder. Larger is better and slower:
# MRR 0.684 / 0.746 / 0.772 at top_n 30 / 60 / 120 on the proxy benchmark.
CODEMEM_RERANK_TOP_N=120
# Blend of fused rank vs cross-encoder score. 0.65 measured best; 0.85+ degrades.
CODEMEM_RERANK_WEIGHT=0.65
# Sigmoid temperature for turning logits into a 0..1 score. Fixed rather than
# derived from the reranked set, so a given logit always contributes the same
# regardless of pool size.
CODEMEM_RERANK_TEMPERATURE=2.0
# The window the cross-encoder reads is a property of the checkpoint and
# resolves with CODEMEM_RERANK_MODEL when left unset:
#   bge-reranker-v2-m3 -> pair cap 2048, document budget 800, probability
#                        scores on (the family emits 0..1 scores);
#   anything else      -> pair cap 512, document budget 200, probability
#                        scores off.
# At the 200-token document budget the bge window truncated exactly the long
# Edit/diff memories the stage exists to judge (decidable 0.567 -> 0.400 on
# the evidence run); at 2048/800 it reached 0.633. Pin these explicitly only
# to trade recall for latency on a CPU-only host. See eval/README.md.
#CODEMEM_RERANK_MAX_LENGTH=2048
#CODEMEM_RERANK_DOC_TOKENS=800
#CODEMEM_RERANK_PROBABILITY_SCORES=true
# Off-session/span variants, measured and left off: see docs and eval/README.md.
CODEMEM_RERANK_SPAN_TOKENS=0
CODEMEM_RERANK_SESSION_LEVEL=false
CODEMEM_CANDIDATE_PER_SESSION=0
CODEMEM_RECALL_CHANNEL_DEPTH=0

# ----------------------------------------------------- listwise reranking -----
# Final ranking stage: an LLM judges candidates COMPARATIVELY, which a
# cross-encoder cannot do because it scores each pair independently.
#
# OFF by default, on measurement. On the proxy benchmark every setting scored
# below the configuration without it (MRR 0.780 -> 0.766, recall@10 0.719 ->
# 0.675) and search went from ~0.8 s to ~4.5 s. Attenuating its weight moves the
# numbers monotonically back toward the baseline, which is the signature of a
# stage adding noise rather than signal. See eval/README.md for the confound:
# the proxy's file-overlap ground truth measures something different from what a
# judge optimises, so this is "unproven here", not "proven useless".
CODEMEM_LISTWISE_ENABLED=false
# Blend of existing score vs judge relevance (0-10 mapped to 0-1).
CODEMEM_LISTWISE_WEIGHT=0.5
# Candidates sent to the judge. Each one costs prompt tokens.
CODEMEM_LISTWISE_MAX_CANDIDATES=40
# Characters of each memory shown to the judge. 1800 measured better than 700
# (recall@10 0.692 vs 0.675), because our retrieval unit is a whole chunk and
# truncating it removes the part that decides relevance.
CODEMEM_LISTWISE_EXCERPT_CHARS=1800

# ------------------------------------------------------- dense retrieval ------
# ON by default. Its value depends on hardware: on GPU it improves nDCG@10 and
# recall@10 over rerank-only; on CPU it added no measurable gain for ~5x the Add
# cost. Both fit the 30-minute Add budget, the GPU ranking is just better.
CODEMEM_DENSE_ENABLED=true
CODEMEM_EMBED_BACKEND=local
CODEMEM_EMBED_MODEL=BAAI/bge-small-en-v1.5
# auto = CUDA when visible, else CPU. ~8x difference on both models.
CODEMEM_EMBED_DEVICE=auto
# Load from the local cache only. Pre-baked at image build time (see Dockerfile);
# without it a deployment host with no route to huggingface.co stalls for minutes.
CODEMEM_EMBED_OFFLINE=true
# Similarity floor. In a same-repository corpus every neighbour is somewhat
# similar, so without a floor the dense channel injects uninformative
# candidates into every query.
CODEMEM_DENSE_MIN_SIMILARITY=0.30
# Cap on memories embedded per Add call, bounding Add latency on very large
# trajectories.
CODEMEM_DENSE_MAX_PER_ADD=400
# ---- dense-only admission ----
# OFF by default and unmeasured. Without it a candidate must be found by
# `lexical` or `entity` to be scored at all, so dense can only re-order what the
# lexical channels already found and cannot recall anything. Turning it on lets a
# memory found by dense ALONE become scoreable, behind the absolute floor below.
# The floor is the whole mechanism: in a same-repo corpus every neighbour is
# somewhat similar, so a relative threshold would let an unrelated query return
# its nearest distractor.
CODEMEM_DENSE_ELIGIBLE=false
CODEMEM_DENSE_ELIGIBLE_MIN_SIMILARITY=0.45
# Cap on dense-only candidates admitted per query. 0 = unlimited.
CODEMEM_DENSE_ELIGIBLE_MAX=0
# ---- dense fill (append-only) ----
# A weaker variant of the above: instead of competing for a slot, a few memories
# that ONLY dense reached are APPENDED after assembly, so every decision the
# lexical channels made is untouched. They land at the tail, which is where a
# token prefix cuts, so this only pays off when the head is short.
CODEMEM_DENSE_FILL=false
CODEMEM_DENSE_FILL_MIN_SIMILARITY=0.50
CODEMEM_DENSE_FILL_MAX=4
CODEMEM_DENSE_FILL_TOKENS=110
# Only used by the `openai` embed backend. Unset uses OPENAI_BASE_URL.
CODEMEM_EMBED_BASE_URL=
